# StaffRoom API Environment Configuration Example

APP_ENV=development
APP_URL=http://localhost/staffroom_api/public
API_PREFIX=/api

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=staffroom_db

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=2592000

# Mail Configuration (PHPMailer SMTP)
MAIL_HOST=mail.staffroomng.com
MAIL_PORT=465
MAIL_USERNAME=info@staffroomng.com
MAIL_PASSWORD=your_mail_password_here
MAIL_FROM_ADDRESS=info@staffroomng.com
MAIL_FROM_NAME=StaffRoom
MAIL_ENCRYPTION=ssl

# Phone verification
TERMII_API_KEY=your_termii_api_key_here
